+    other.id = next_id;
+    other.name = next_name;
+    selected.materials.push_back(other);
+    REQUIRE(lua.run_script("second = bed:material_preset_info(1)").valid());
+    REQUIRE(lua.state()["second"]["name"].get<std::string>() == next_name);
