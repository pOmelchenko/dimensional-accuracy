-- SPDX-License-Identifier: AGPL-3.0-only
-- Synthetic host for CLI serialization tests only; never part of the plugin bundle.
dofile(arg[1])
local overrides = dofile(arg[2])
local opts = {}
for _, param in ipairs(info.params) do opts[param.name] = param.default end
for key, value in pairs(overrides) do opts[key] = value end
local values = {
    filament_shrinkage_compensation_xy = 0,
    filament_shrinkage_compensation_z = 0,
    xy_size_compensation = 0
}
local writes = 0
local mode = arg[3] or "normal"
local settings = {
    value = function(_, key)
        if mode == "unreadable_xy" and writes > 0 and key == "filament_shrinkage_compensation_xy" then return {} end
        return values[key]
    end,
    set = function(_, key, value)
        writes = writes + 1
        if mode == "noop_xy" and key == "filament_shrinkage_compensation_xy" then return end
        if mode == "throw_z" and key == "filament_shrinkage_compensation_z" then error("synthetic setter failure") end
        values[key] = value
    end
}
api = {project = {current_bed = function()
    return {
        material_presets = function() return settings end,
        print_presets = function() return settings end
    }
end}}
local ok, message = pcall(execute, opts)
if not ok then io.stderr:write(tostring(message) .. "\n"); os.exit(1) end
